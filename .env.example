# ==============================================================================
# Environment Configuration - myp-apps
# ==============================================================================

# General
ENVIRONMENT=development
PROJECT_NAME="myp-apps"
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_USER=myp_user
POSTGRES_PASSWORD=myp_password
POSTGRES_DB=myp_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://myp_user:myp_password@postgres:5432/myp_db
DATABASE_SYNC_URL=postgresql://myp_user:myp_password@postgres:5432/myp_db

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
